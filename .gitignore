# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# Signing. The keystore and its passwords are the one secret in this repo:
# whoever holds both can publish updates as us, and the key cannot be rotated
# once the app is live. keystore.properties.template is the committed example.
*.jks
*.keystore
keystore.properties

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (Firebase Analytics + Crashlytics)
# google-services.json is intentionally NOT ignored: the google-services
# Gradle plugin refuses to build without it, and the file ships inside every
# published APK anyway, so it is config rather than a secret. What is checked
# in is a placeholder - see README before shipping.

# Version control
vcs.xml

# Lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
lint/reports/

# Test outputs
test-results/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment files
.env
.env.local
*.log
crashLogs
