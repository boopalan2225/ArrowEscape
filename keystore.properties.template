# Release signing credentials for Arrow Escape.
#
# Copy this file to `keystore.properties` (same directory) and fill in the
# real values. That copy is gitignored and must never be committed - anyone
# holding it plus the .jks can publish updates as you.
#
# Create the keystore first:
#
#   keytool -genkeypair -v \
#     -keystore arrowescape-release.jks \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -alias arrowescape
#
# Use 10000 days: Play requires the key to outlive every update you will ever
# ship, and the key can never be swapped once the app is live.
#
# Back up the .jks AND these passwords somewhere offline. Losing them means
# losing the ability to update the listing, permanently.

# Path to the keystore, relative to the repo root (or absolute).
storeFile=arrowescape-release.jks

# Password for the keystore file itself.
storePassword=

# Alias of the key inside the keystore (-alias above).
keyAlias=arrowescape

# Password for that specific key. Often the same as storePassword.
keyPassword=
