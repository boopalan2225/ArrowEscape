    <!-- ======================= Privacy Policy screen ======================= -->
    <string name="privacy_short_body">We do not ask for your name, email or phone number, and we do not sell anything about you. The game runs offline; the only data that leaves your device is what ads and the optional Play Games sign-in need.</string>
    <string name="privacy_card_device_title">What stays on your device</string>
    <string name="privacy_bullet_progress">Current level, best level and stars, for each mode.</string>
    <string name="privacy_bullet_settings">Your settings: theme, sound and haptics.</string>
    <string name="privacy_device_body">This lives in the app\'s private storage and is removed when you uninstall the game.</string>
    <string name="privacy_card_ads_title">Advertising</string>
    <string name="privacy_ads_body">Rewarded and interstitial ads are served by Google AdMob. To show and measure ads, AdMob may process your device\'s advertising ID, coarse location derived from your IP address, and basic device and app information. You can reset or delete the advertising ID in Android Settings, under Privacy, Ads.</string>
    <string name="privacy_card_cloud_title">Optional cloud save</string>
    <string name="privacy_cloud_body">If you sign in with Google Play Games, your progress is stored in your own Play Games saved-games space so it follows you to a new device. We see only your Play Games display name and that saved progress. Sign out any time in Settings; playing offline is always an option.</string>
    <string name="privacy_card_children_title">Children</string>
    <string name="privacy_children_body">The game is suitable for all ages and collects no personal details. Where required, ad requests are marked as child-directed so only non-personalised ads are served.</string>
    <string name="privacy_card_choices_title">Your choices</string>
    <string name="privacy_bullet_reset">Reset progress any time from Settings.</string>
    <string name="privacy_bullet_signout">Sign out of Play Games to stop cloud saves.</string>
    <string name="privacy_bullet_uninstall">Uninstall to erase everything stored locally.</string>
    <string name="privacy_card_others_title">Who else is involved</string>
    <string name="privacy_bullet_admob">Google AdMob - serves and measures the ads.</string>
    <string name="privacy_bullet_playgames">Google Play Games - optional sign-in and cloud save.</string>
    <string name="privacy_bullet_playstore">Google Play - distributes the app and its updates.</string>
    <string name="privacy_others_body">No other company receives data from this game, and we run no analytics or tracking of our own.</string>
    <string name="privacy_card_changes_title">Changes to this policy</string>
    <string name="privacy_changes_body">If this policy changes, the new version appears here with a fresh date, and significant changes are called out in the release notes.</string>
    <string name="privacy_contact_body">Questions, or want your cloud save deleted? Write to %1$s and we will answer within 30 days.</string>

    <!-- ======================= Terms of Service screen ======================= -->
    <string name="terms_short_body">Play the game, enjoy it, do not try to break it or resell it. Installing or playing Arrow Escape means you accept these terms.</string>
    <string name="terms_card_license_title">Your licence to play</string>
    <string name="terms_license_body">We grant you a personal, non-exclusive, non-transferable licence to install and play Arrow Escape on devices you control, for your own entertainment. The game, its levels, artwork, sounds and code stay ours.</string>
    <string name="terms_card_not_allowed_title">What you agree not to do</string>
    <string name="terms_bullet_reverse_engineer">Reverse engineer, decompile or modify the app.</string>
    <string name="terms_bullet_redistribute">Redistribute, sell or sublicense it, in whole or in part.</string>
    <string name="terms_bullet_cheats">Use cheats, bots or tooling that fakes progress or ad views.</string>
    <string name="terms_bullet_ads">Strip out, hide or interfere with advertising.</string>
    <string name="terms_card_ads_title">Ads and third parties</string>
    <string name="terms_ads_body">The game is free and paid for by ads. Advertising is served by Google AdMob and governed by their terms; optional cloud save runs on Google Play Games. What they receive is spelled out in the Privacy Policy.</string>
    <string name="terms_card_progress_title">Your progress</string>
    <string name="terms_progress_body">Progress is stored on your device, and in your own Play Games saved-games space if you sign in. We do our best to keep it safe, but we cannot guarantee it against device loss, uninstalls or platform changes.</string>
    <string name="terms_card_warranty_title">No warranty</string>
    <string name="terms_warranty_body">The game is provided \"as is\". To the extent the law allows, we are not liable for lost progress, lost time, or any indirect damages arising from playing it.</string>
    <string name="terms_card_changes_title">Changes and ending the deal</string>
    <string name="terms_changes_body">These terms may change; the current version always lives here with a fresh date, and continuing to play means accepting it. You can end this agreement at any time by uninstalling the game.</string>
    <string name="terms_contact_body">Questions about these terms? Write to %1$s.</string>

