    <!-- ======================= About screen ======================= -->
    <string name="about_version">Version %1$s</string>
    <string name="about_card_idea_title">The idea</string>
    <string name="about_card_idea_body">Every arrow wants out. Tap one and it bolts in the direction it points - but only if nothing stands in its way. Clear the board and the shape it was hiding sets itself free.</string>
    <string name="about_card_how_to_play_title">How to play</string>
    <string name="about_bullet_escape">An arrow escapes only when its path to the edge is clear.</string>
    <string name="about_bullet_blocked">Tap a blocked arrow and it costs a life. Three per level.</string>
    <string name="about_bullet_stars">Clear fast and clean for three stars.</string>
    <string name="about_bullet_hints">Stuck? Two hints per level point out a safe tap.</string>
    <string name="about_card_two_ways_title">Two ways to play</string>
    <string name="about_bullet_classic">Classic: arrows on a grid, shapes drawn in cells.</string>
    <string name="about_bullet_curved">Curved: arrows flow along the lines of a drawn figure.</string>
    <string name="about_two_ways_body">Each mode keeps its own progress, so switching never costs a level.</string>
    <string name="about_card_make_it_yours_title">Make it yours</string>
    <string name="about_make_it_yours_body">Five appearances - Classic, Midnight, Sunset, Pirate and Ink - each with its own home screen, motion and sound. Prefer to follow your phone? Pick System in Settings.</string>
    <string name="about_card_progress_safe_title">Your progress is safe</string>
    <string name="about_progress_safe_body">Everything is stored on your device and plays offline. Sign in with Play Games and your journey rides along to your next phone.</string>
    <string name="about_link_terms">Terms of Service</string>
    <string name="about_link_licenses">Licenses</string>

