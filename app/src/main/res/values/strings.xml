    <!-- ======================= Onboarding tour (Home) ======================= -->
    <string name="tour_home_modes_title">Pick your game</string>
    <string name="tour_home_modes_body">Classic lays arrows on a grid; Curved flows them around a drawn figure. Each mode keeps its own progress.</string>
    <string name="tour_home_progress_title">Your place in the story</string>
    <string name="tour_home_progress_body">The level you are on, how far through the journey you are, and your best run so far.</string>
    <string name="tour_home_play_title">Start here</string>
    <string name="tour_home_play_body">Tap an arrow and it escapes in the direction it points - but only if its path is clear. Three lives per level.</string>
    <string name="tour_home_journey_title">The Journey map</string>
    <string name="tour_home_journey_body">Chapters of ten levels, your stars on each, and a peek at what is still locked.</string>
    <string name="tour_home_settings_title">Make it yours</string>
    <string name="tour_home_settings_body">Five appearances, each with its own look and sound, plus sound and haptics switches and this walkthrough any time you want it.</string>

    <!-- ======================= Onboarding tour (in-game) ======================= -->
    <string name="tour_game_board1_title">Your first move</string>
    <string name="tour_game_board1_body">Find an arrow with a clear run to the edge it points at, and tap it. Go on - the board is live.</string>
    <string name="tour_game_board2_title">Now one more</string>
    <string name="tour_game_board2_body">Every arrow that leaves opens a path for another. Tap a second one and watch the board loosen up.</string>
    <string name="tour_game_lives_title">Arrows left, and lives</string>
    <string name="tour_game_lives_body">Tap a blocked arrow and it shakes instead of leaving - and costs one of these three hearts.</string>
    <string name="tour_game_hint_title">Stuck? Take a hint</string>
    <string name="tour_game_hint_body">Two hints a level point out an arrow that can leave right now. Run out and you can watch an ad for more.</string>

